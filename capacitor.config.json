{
  "appId": "com.ventexiq.journey",
  "appName": "Journey",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "appendUserAgent": "JourneyApp/1",
    "useLegacyBridge": true
  },
  "ios": {
    "appendUserAgent": "JourneyApp/1"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "CapacitorUpdater": {
      "autoUpdate": true,
      "appReadyTimeout": 15000,
      "autoDeleteFailed": true
    }
  }
}
